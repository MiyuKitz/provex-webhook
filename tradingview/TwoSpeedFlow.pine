//@version=6
// ============================================================================
//  TWO-SPEED FLOW  v1.0   (Krysie x Claude, Nov 2026)
//  An order-flow / smart-money execution indicator built from public concepts:
//  market structure (BOS / CHoCH), order blocks + mitigation blocks, fair value
//  gaps, resting liquidity pools (BSL / SSL, incl. higher-timeframe), a session
//  volume profile (POC / VAH / VAL + buy/sell split), regime filter (chop + ADX),
//  HTF trend, ADR exhaustion, Asia-range sweeps, accumulation boxes, a
//  TAKE / WAIT / AVOID trade opinion, SL + 3 targets + trailing, an HONEST
//  performance tracker (full R per trade, not just "TP1 touched"), a HUD, and
//  JSON alerts that the Two-Speed bot can receive by webhook.
// ============================================================================
indicator("Two-Speed Flow", shorttitle = "TS Flow", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ───────────────────────────── INPUTS ─────────────────────────────
gSes = "=== SESSION FILTERS ==="
tzIn        = input.string("America/New_York", "Time Zone", group = gSes)
sesMorning  = input.session("0600-1100", "Morning Session", group = gSes)
sesEvening  = input.session("1800-2300", "Evening Session", group = gSes)
restrictSes = input.bool(false, "Restrict New Entries To Sessions", group = gSes)

gStr = "=== MARKET STRUCTURE (CHoCH / BOS) ==="
showChoch = input.bool(true, "Show Change of Character (CHoCH)", group = gStr)
showBos   = input.bool(false, "Show Break of Structure (BOS)", group = gStr)
swingLen  = input.int(7, "Structure Swing Lookback", minval = 2, maxval = 50, group = gStr)
breakMode = input.string("Candle Close", "Breakout Detection Mode", options = ["Candle Close", "Wick Break"], group = gStr)
showBrkLn = input.bool(true, "Draw Structural Break Lines", group = gStr)
cBull     = input.color(#00e6c8, "Bullish Structure Color", group = gStr)
cBear     = input.color(#ff1744, "Bearish Structure Color", group = gStr)

gOB = "=== ORDER BLOCKS & MITIGATION BLOCKS ==="
purgeSMC  = input.bool(true, "Purge Mitigated SMC Boxes", group = gOB)
showOB    = input.bool(true, "Enable Order Blocks", group = gOB)
obSearch  = input.int(10, "OB Origin Search Lookback", minval = 1, maxval = 50, group = gOB)
obMinDisp = input.float(0.3, "Min Displacement to Validate OB (x ATR)", minval = 0.0, step = 0.05, group = gOB)
obMax     = input.int(5, "Max Active OBs", minval = 1, maxval = 30, group = gOB)
showMit   = input.bool(true, "Enable Mitigation Blocks (Flipped OBs)", group = gOB)
mitMax    = input.int(4, "Max Active Mitigation Blocks", minval = 1, maxval = 30, group = gOB)
cBullOB   = input.color(#26a69a33, "Bullish OB Fill", group = gOB)
cBearOB   = input.color(#ef535033, "Bearish OB Fill", group = gOB)
cMit      = input.color(#9e9e9e26, "Mitigation Block Fill", group = gOB)
zoneTxtT  = input.int(80, "Zone Text Transparency %", minval = 0, maxval = 100, group = gOB)

gFVG = "=== LIQUIDITY VOIDS / FAIR VALUE GAPS ==="
showFVG   = input.bool(true, "Enable Liquidity Voids (FVGs)", group = gFVG)
fvgMinAtr = input.float(0.1, "Min Gap Size to Qualify (x ATR)", minval = 0.0, step = 0.05, group = gFVG)
fvgMode   = input.string("100% Full Fill", "Void Mitigation Trigger", options = ["50% CE", "100% Full Fill"], group = gFVG)
fvgMax    = input.int(4, "Max Active Voids", minval = 1, maxval = 30, group = gFVG)
cBullFVG  = input.color(#2196f326, "Bullish Void Fill", group = gFVG)
cBearFVG  = input.color(#e91e6326, "Bearish Void Fill", group = gFVG)

gLiq = "=== RESTING LIQUIDITY (BSL / SSL) ==="
purgeLiq   = input.bool(true, "Purge Swept Liquidity Pools", group = gLiq)
showLiq    = input.bool(true, "Draw Resting Liquidity Pools", group = gLiq)
anchorWick = input.bool(false, "Anchor Pools to Rejection Wicks", group = gLiq)
wickRatio  = input.float(0.4, "Min Rejection Wick Ratio", minval = 0.0, maxval = 1.0, step = 0.05, group = gLiq)
useHtfLiq  = input.bool(true, "Include HTF Liquidity Pools", group = gLiq)
htfLiqTf   = input.timeframe("60", "HTF Liquidity Resolution", group = gLiq)
majorLen   = input.int(20, "Major Liquidity Pivot Lookback", minval = 3, maxval = 100, group = gLiq)
minorLen   = input.int(7, "Minor Liquidity Pivot Lookback", minval = 2, maxval = 50, group = gLiq)
showMinor  = input.bool(true, "Show Low Density (Minor) Pools", group = gLiq)
minorTxt   = input.bool(false, "Show Minor Pool Text Labels", group = gLiq)
eqTol      = input.float(0.15, "Equal High/Low Cluster Tolerance (x ATR)", minval = 0.0, step = 0.05, group = gLiq)
liqExt     = input.int(20, "Forward Extension Bars", minval = 0, maxval = 200, group = gLiq)
cBSL       = input.color(#7b1fa2, "Buy-Side Liquidity (BSL)", group = gLiq)
cSSL       = input.color(#1565c0, "Sell-Side Liquidity (SSL)", group = gLiq)

gBox = "=== CONSOLIDATION BOX ENGINE ==="
boxOn      = input.bool(true, "Enable Consolidation Boxes", group = gBox)
boxMode    = input.string("Session Anchor", "Box Engine Mode", options = ["Session Anchor", "Dynamic Squeeze"], group = gBox)
boxHours   = input.float(3.0, "Session Box Tracking Duration (Hours)", minval = 0.5, step = 0.5, group = gBox)
boxMaxHist = input.int(30, "Max Historical Boxes", minval = 5, maxval = 250, group = gBox)
sqSens     = input.string("Balanced", "Squeeze Sensitivity", options = ["Tight", "Balanced", "Loose"], group = gBox)
sqMinBars  = input.int(4, "Min Compression Bars to Form Box", minval = 3, maxval = 50, group = gBox)
driftBuf   = input.float(0.75, "Drift Invalidation Buffer (x ATR)", minval = 0.0, step = 0.05, group = gBox)
cBox       = input.color(#fff9c4, "Box Tint", group = gBox)
boxBgT     = input.int(94, "Box Background Transparency %", minval = 0, maxval = 100, group = gBox)

gHtf = "=== HIGHER TIMEFRAME TREND ==="
useHtf  = input.bool(false, "Enable HTF Trend Filter (hard block)", group = gHtf)
htfTf   = input.timeframe("60", "HTF Trend Resolution", group = gHtf)
htfFast = input.int(10, "HTF Fast EMA", minval = 1, group = gHtf)
htfSlow = input.int(30, "HTF Slow EMA", minval = 2, group = gHtf)

gAdr = "=== AVERAGE DAILY RANGE ==="
adrLen   = input.int(14, "ADR Period (Days)", minval = 1, group = gAdr)
adrLimit = input.float(85, "ADR Exhaustion Threshold (%)", minval = 10, group = gAdr)

gReg = "=== ANTI-CHOP & REGIME ==="
useChop = input.bool(true, "Enable Anti-Chop Filter", group = gReg)
chopLen = input.int(14, "Choppiness Index Period", minval = 2, group = gReg)
chopThr = input.float(55, "Chop Threshold (Above = Ranging)", group = gReg)
useAdx  = input.bool(true, "Enable ADX Trend Filter", group = gReg)
adxLen  = input.int(14, "ADX Period", minval = 2, group = gReg)
adxMin  = input.float(20, "ADX Min (Below = Weak)", group = gReg)

gVP = "=== VOLUME PROFILE & DELTA ==="
vpOn    = input.bool(true, "Enable Volume Profile Engine", group = gVP)
vpMode  = input.string("Session", "Profile Span", options = ["Session", "Daily", "Weekly"], group = gVP)
showVP  = input.bool(true, "Show Volume Histogram", group = gVP)
vpRows  = input.int(50, "Profile Price Rows", minval = 10, maxval = 100, group = gVP)
vaPct   = input.float(70, "Value Area %", minval = 10, maxval = 99, group = gVP)
vpWidth = input.int(30, "Histogram Width (bars)", minval = 5, maxval = 150, group = gVP)
showPOC = input.bool(true, "Show POC / VAH / VAL Lines", group = gVP)
cBuyV   = input.color(#26a69a, "Buy Volume Fill", group = gVP)
cSellV  = input.color(#ef5350, "Sell Volume Fill", group = gVP)
cPOC    = input.color(#ffeb3b, "Point of Control", group = gVP)
cVA     = input.color(#ffb300, "VAH / VAL Lines", group = gVP)

gSig = "=== SIGNAL ENGINE ==="
showSig      = input.bool(true, "Show Signals", group = gSig)
sigStyle     = input.string("Evaluation Labels", "Signal Style", options = ["Evaluation Labels", "Classic Arrows"], group = gSig)
showWaitAv   = input.bool(true, "Show WAIT / AVOID Labels", group = gSig)
engine       = input.string("Hybrid", "Signal Trigger Engine", options = ["Hybrid", "Retest Only", "Breakout Only", "Sweep Only"], group = gSig)
allowCont    = input.bool(false, "Allow Continuation / Re-entry Signals", group = gSig)
minBetween   = input.int(10, "Min Bars Between Same-Side Signals", minval = 1, group = gSig)
dispBody     = input.float(0.35, "Displacement Body Threshold (x ATR)", minval = 0.0, step = 0.05, group = gSig)
blockIntoLiq = input.bool(true, "Block Breakouts Into Resting Liquidity", group = gSig)
reqDelta     = input.bool(true, "Require Order Flow (Delta) Alignment", group = gSig)
reqPOC       = input.bool(true, "Require Correct Side of POC", group = gSig)
waitRecovery = input.bool(true, "Enable WAIT -> Retest TAKE Recovery", group = gSig)
maxWait      = input.int(8, "Max Bars to Hold WAIT Setup", minval = 1, maxval = 50, group = gSig)
useWeighted  = input.bool(false, "Use Weighted Scoring", group = gSig)
minTake      = input.int(2, "Min Score for TAKE", group = gSig)
minWaitSc    = input.int(0, "Min Score for WAIT", group = gSig)
setupRules   = input.bool(true, "Setup-Specific Rules (breakouts not punished for momentum)", group = gSig)
softHard     = input.bool(true, "Split Soft / Hard Liquidity Barriers", group = gSig)

gRisk = "=== RISK & TARGETS ==="
slMode     = input.string("Structure", "Stop Loss Mode", options = ["Structure", "ATR"], group = gRisk)
atrMult    = input.float(1.5, "ATR Multiplier for Stop Loss", minval = 0.1, step = 0.1, group = gRisk)
tp1M       = input.float(1.0, "TP1 (x SL distance)", minval = 0.1, step = 0.1, group = gRisk)
tp2M       = input.float(2.0, "TP2 (x SL distance)", minval = 0.1, step = 0.1, group = gRisk)
tp3M       = input.float(3.0, "TP3 (x SL distance)", minval = 0.1, step = 0.1, group = gRisk)
trailAtr   = input.float(2.0, "Trail after TP1 (x ATR)", minval = 0.1, step = 0.1, group = gRisk)
keepHist   = input.bool(false, "Keep Historical Target Lines", group = gRisk)
histT      = input.int(75, "Historical Targets Transparency %", minval = 0, maxval = 100, group = gRisk)
tgtExt     = input.int(15, "Target Line Extension (bars)", minval = 1, maxval = 200, group = gRisk)
showTgtLbl = input.bool(true, "Show TP / SL Price Labels", group = gRisk)
cSL        = input.color(#f23645, "Stop Loss Color", group = gRisk)
cTP        = input.color(#00bcd4, "Targets Color", group = gRisk)
cTrail     = input.color(#ff9800, "Trailing Line Color", group = gRisk)

gHud = "=== HUD ==="
hudOn   = input.bool(true, "Display HUD", group = gHud)
hudPos  = input.string("Top Right", "HUD Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = gHud)
hudSize = input.string("Small", "HUD Size", options = ["Tiny", "Small", "Normal"], group = gHud)
hudBgT  = input.int(15, "HUD Background Transparency %", minval = 0, maxval = 100, group = gHud)

gAl = "=== ALERTS ==="
alTake  = input.bool(true, "Alert: Confirmed Entries (TAKE)", group = gAl)
alWait  = input.bool(false, "Alert: Setups Needing Retest (WAIT)", group = gAl)
alAvoid = input.bool(false, "Alert: Trap / Blocked (AVOID)", group = gAl)
alChoch = input.bool(false, "Alert: CHoCH", group = gAl)
alJson  = input.bool(true, "Alert Message as JSON (for the bot webhook)", group = gAl)

// ───────────────────────────── TYPES & STATE ─────────────────────────────
type Zone
    box bx
    float top
    float bot
    int dir
    int born
    string kind

type Pool
    line ln
    box bx
    label lb
    float lvl
    int dir
    int touches
    bool major
    bool htf

var array<Zone> obs      = array.new<Zone>()
var array<Zone> mits     = array.new<Zone>()
var array<Zone> fvgs     = array.new<Zone>()
var array<Pool> pools    = array.new<Pool>()
var array<float> recHi   = array.new<float>()
var array<float> recLo   = array.new<float>()
var array<box> boxHist   = array.new<box>()
var array<box> vpBoxes   = array.new<box>()
var array<line> vpLines  = array.new<line>()
var array<line> tLines   = array.new<line>()
var array<label> tLabels = array.new<label>()

// trade state
var int tDir      = 0
var int tBar      = 0
var float tEntry  = na
var float tSL     = na
var float tRisk   = na
var float tTP1    = na
var float tTP2    = na
var float tTP3    = na
var int tStage    = 0
var string tSetup = ""
// performance (full R per trade)
var int nTrades  = 0
var int nWins    = 0
var int nTp1     = 0
var float sumR   = 0.0
var float grossW = 0.0
var float grossL = 0.0
// last signal (HUD)
var int lastSigDir   = 0
var int lastSigBar   = -100000
var string lastName  = "-"
var string lastQ     = "-"
var string lastWhy   = "-"
// WAIT tracker
var int waitDir      = 0
var int waitBar      = 0
var float waitTop    = na
var float waitBot    = na
var string waitName  = ""

// ───────────────────────────── CORE SERIES ─────────────────────────────
atr14   = ta.atr(14)
atr5    = ta.atr(5)
ema10   = ta.ema(close, 10)
ema30   = ta.ema(close, 30)
body    = math.abs(close - open)
rng     = high - low
safeRng = math.max(rng, syminfo.mintick)
vol     = nz(volume)
buyFrac = rng > 0 ? (close - low) / rng : 0.5
buyVol  = vol * buyFrac
sellVol = vol - buyVol
buyPct  = buyFrac * 100
lowerWick = (math.min(open, close) - low) / safeRng
upperWick = (high - math.max(open, close)) / safeRng

// sessions (entry filter, user time zone)
inMorning = not na(time(timeframe.period, sesMorning, tzIn))
inEvening = not na(time(timeframe.period, sesEvening, tzIn))
sessionOk = not restrictSes or inMorning or inEvening

// market sessions, New York time (DST handled by the exchange time zone)
inAsia   = not na(time(timeframe.period, "1800-0300", "America/New_York"))
inLondon = not na(time(timeframe.period, "0300-0800", "America/New_York"))
inNY     = not na(time(timeframe.period, "0800-1800", "America/New_York"))
sessId    = inAsia ? 0 : inLondon ? 1 : inNY ? 2 : -1
sessStart = sessId >= 0 and sessId != nz(sessId[1], -1)
sessName  = sessId == 0 ? "ASIA" : sessId == 1 ? "LONDON" : "NY"

// HTF trend (non-repainting: previous closed HTF bar)
[hFast, hSlow] = request.security(syminfo.tickerid, htfTf, [ta.ema(close, htfFast)[1], ta.ema(close, htfSlow)[1]], lookahead = barmerge.lookahead_on)
htfBias = na(hFast) or na(hSlow) ? 0 : hFast > hSlow ? 1 : -1
ltfBias = ema10 > ema30 ? 1 : -1

// ADR exhaustion
adrVal = request.security(syminfo.tickerid, "D", ta.atr(adrLen)[1], lookahead = barmerge.lookahead_on)
newDay = timeframe.change("D")
var float dHi = na
var float dLo = na
if newDay or na(dHi)
    dHi := high
    dLo := low
else
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)
adrPct = nz(adrVal) > 0 ? (dHi - dLo) / adrVal * 100 : 0.0
adrExh = adrPct >= adrLimit

// Asia range sweep tracker
var float aHi  = na
var float aLo  = na
var float pAHi = na
var float pALo = na
var bool aSweptH = false
var bool aSweptL = false
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
else if inAsia
    aHi := na(aHi) ? high : math.max(aHi, high)
    aLo := na(aLo) ? low : math.min(aLo, low)
if not inAsia and inAsia[1]
    pAHi := aHi
    pALo := aLo
    aSweptH := false
    aSweptL := false
if not inAsia and not na(pAHi)
    if high > pAHi
        aSweptH := true
    if low < pALo
        aSweptL := true

// regime
chopDen  = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
chopSum  = math.sum(ta.atr(1), chopLen)
chopVal  = chopDen > 0 ? 100 * math.log10(chopSum / chopDen) / math.log10(chopLen) : 50.0
[diP, diM, adxV] = ta.dmi(adxLen, adxLen)
isChoppy = useChop and chopVal > chopThr
isWeak   = useAdx and adxV < adxMin
regimeTxt = isChoppy ? "RANGING" : isWeak ? "WEAK TREND" : "TRENDING"

// squeeze factors (global so they compute every bar)
sens     = sqSens == "Tight" ? 0.8 : sqSens == "Balanced" ? 1.0 : 1.25
hiN      = ta.highest(high, sqMinBars)
loN      = ta.lowest(low, sqMinBars)
avgBody  = ta.sma(body, sqMinBars)
ovl      = ta.sma(math.max(math.min(high, high[1]) - math.max(low, low[1]), 0.0), sqMinBars) / math.max(ta.sma(rng, sqMinBars), syminfo.mintick)
sqScore  = (hiN - loN < 1.5 * atr14 * sens ? 1 : 0) + (atr5 < atr14 * 0.85 * sens ? 1 : 0) + (ovl > 0.5 / sens ? 1 : 0) + (avgBody < 0.5 * atr14 * sens ? 1 : 0)
squeeze  = sqScore >= 3

// pivots
ph    = ta.pivothigh(high, swingLen, swingLen)
pl    = ta.pivotlow(low, swingLen, swingLen)
phMin = ta.pivothigh(high, minorLen, minorLen)
plMin = ta.pivotlow(low, minorLen, minorLen)
phMaj = ta.pivothigh(high, majorLen, majorLen)
plMaj = ta.pivotlow(low, majorLen, majorLen)
htfOk = timeframe.in_seconds() < timeframe.in_seconds(htfLiqTf)
htfPH = request.security(syminfo.tickerid, htfLiqTf, ta.pivothigh(high, 3, 3)[1], lookahead = barmerge.lookahead_on)
htfPL = request.security(syminfo.tickerid, htfLiqTf, ta.pivotlow(low, 3, 3)[1], lookahead = barmerge.lookahead_on)

// ───────────────────────────── MARKET STRUCTURE ─────────────────────────────
var float swHi    = na
var int swHiBar   = 0
var bool swHiDone = true
var float swLo    = na
var int swLoBar   = 0
var bool swLoDone = true
var int structTrend = 0
if not na(ph)
    swHi := ph
    swHiBar := bar_index - swingLen
    swHiDone := false
if not na(pl)
    swLo := pl
    swLoBar := bar_index - swingLen
    swLoDone := false

bool bullBreak = false
bool bearBreak = false
bool bullChoch = false
bool bearChoch = false
if not swHiDone and not na(swHi)
    if (breakMode == "Candle Close" ? close > swHi : high > swHi)
        swHiDone := true
        bullBreak := true
        bullChoch := structTrend == -1
        structTrend := 1
        if showBrkLn and ((bullChoch and showChoch) or (not bullChoch and showBos))
            line.new(swHiBar, swHi, bar_index, swHi, color = cBull, style = line.style_dashed, width = 1)
            label.new(int((swHiBar + bar_index) / 2), swHi, bullChoch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(color.black, 100), textcolor = cBull, size = size.tiny)
if not swLoDone and not na(swLo)
    if (breakMode == "Candle Close" ? close < swLo : low < swLo)
        swLoDone := true
        bearBreak := true
        bearChoch := structTrend == 1
        structTrend := -1
        if showBrkLn and ((bearChoch and showChoch) or (not bearChoch and showBos))
            line.new(swLoBar, swLo, bar_index, swLo, color = cBear, style = line.style_dashed, width = 1)
            label.new(int((swLoBar + bar_index) / 2), swLo, bearChoch ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(color.black, 100), textcolor = cBear, size = size.tiny)

// ───────────────────────────── ZONE HELPERS ─────────────────────────────
f_trim(array<Zone> zs, int mx) =>
    while array.size(zs) > mx
        z = array.shift(zs)
        box.delete(z.bx)
    true

// Walks a zone list: extends live zones, reports retests, removes mitigated ones.
// Returns [bullHit, bearHit, bullTop, bullBot, bearTop, bearBot, bullKind, bearKind]
f_update(array<Zone> zs, bool isFvg, bool makeMit) =>
    bool hitB = false
    bool hitS = false
    float bT = na
    float bB = na
    float sT = na
    float sB = na
    string kB = ""
    string kS = ""
    if array.size(zs) > 0
        for i = array.size(zs) - 1 to 0
            z = array.get(zs, i)
            bool dead = false
            if z.dir == 1
                if bar_index > z.born and low <= z.top and close >= z.bot
                    hitB := true
                    bT := z.top
                    bB := z.bot
                    kB := z.kind
                dead := isFvg ? (fvgMode == "50% CE" ? low <= (z.top + z.bot) / 2 : low <= z.bot) : close < z.bot
            else
                if bar_index > z.born and high >= z.bot and close <= z.top
                    hitS := true
                    sT := z.top
                    sB := z.bot
                    kS := z.kind
                dead := isFvg ? (fvgMode == "50% CE" ? high >= (z.top + z.bot) / 2 : high >= z.top) : close > z.top
            if dead and bar_index > z.born
                if makeMit and showMit
                    mb = box.new(z.born, z.top, bar_index, z.bot, border_color = color.new(color.gray, 40), border_style = line.style_dashed, bgcolor = cMit, text = z.dir == 1 ? "Mitigation (res)" : "Mitigation (sup)", text_size = size.tiny, text_color = color.new(color.gray, zoneTxtT), text_halign = text.align_right)
                    array.push(mits, Zone.new(mb, z.top, z.bot, -z.dir, bar_index, "Mitigation Block"))
                if purgeSMC
                    box.delete(z.bx)
                else
                    box.set_right(z.bx, bar_index)
                    box.set_bgcolor(z.bx, color.new(color.gray, 93))
                array.remove(zs, i)
            else
                box.set_right(z.bx, bar_index)
    [hitB, hitS, bT, bB, sT, sB, kB, kS]

// ───────────────────────────── ORDER BLOCKS ─────────────────────────────
if bullBreak and showOB
    int k0 = -1
    for k = 1 to obSearch
        if close[k] < open[k]
            k0 := k
            break
    if k0 > 0 and close - high[k0] >= obMinDisp * atr14
        b = box.new(bar_index - k0, high[k0], bar_index, low[k0], border_color = color.new(cBull, 50), bgcolor = cBullOB, text = "Bull OB", text_size = size.tiny, text_color = color.new(cBull, zoneTxtT), text_halign = text.align_right)
        array.push(obs, Zone.new(b, high[k0], low[k0], 1, bar_index, "Order Block"))
if bearBreak and showOB
    int k1 = -1
    for k = 1 to obSearch
        if close[k] > open[k]
            k1 := k
            break
    if k1 > 0 and low[k1] - close >= obMinDisp * atr14
        b = box.new(bar_index - k1, high[k1], bar_index, low[k1], border_color = color.new(cBear, 50), bgcolor = cBearOB, text = "Bear OB", text_size = size.tiny, text_color = color.new(cBear, zoneTxtT), text_halign = text.align_right)
        array.push(obs, Zone.new(b, high[k1], low[k1], -1, bar_index, "Order Block"))
f_trim(obs, obMax * 2)

// ───────────────────────────── FAIR VALUE GAPS ─────────────────────────────
bullGap = low > high[2] and (low - high[2]) >= fvgMinAtr * atr14
bearGap = high < low[2] and (low[2] - high) >= fvgMinAtr * atr14
if showFVG and bullGap
    b = box.new(bar_index - 2, low, bar_index, high[2], border_color = color.new(cBull, 70), border_style = line.style_dotted, bgcolor = cBullFVG, text = "VOID (FVG)", text_size = size.tiny, text_color = color.new(cBull, zoneTxtT), text_halign = text.align_right)
    array.push(fvgs, Zone.new(b, low, high[2], 1, bar_index, "Liquidity Void (FVG)"))
if showFVG and bearGap
    b = box.new(bar_index - 2, low[2], bar_index, high, border_color = color.new(cBear, 70), border_style = line.style_dotted, bgcolor = cBearFVG, text = "VOID (FVG)", text_size = size.tiny, text_color = color.new(cBear, zoneTxtT), text_halign = text.align_right)
    array.push(fvgs, Zone.new(b, low[2], high, -1, bar_index, "Liquidity Void (FVG)"))
f_trim(fvgs, fvgMax * 2)

[obBH, obSH, obBT, obBB, obST, obSB, obKB, obKS] = f_update(obs, false, true)
[fvBH, fvSH, fvBT, fvBB, fvST, fvSB, fvKB, fvKS] = f_update(fvgs, true, false)
[mtBH, mtSH, mtBT, mtBB, mtST, mtSB, mtKB, mtKS] = f_update(mits, false, false)
f_trim(mits, mitMax)

zBullHit  = obBH or fvBH or mtBH
zBullTop  = obBH ? obBT : fvBH ? fvBT : mtBT
zBullBot  = obBH ? obBB : fvBH ? fvBB : mtBB
zBullKind = obBH ? obKB : fvBH ? fvKB : mtKB
zBearHit  = obSH or fvSH or mtSH
zBearTop  = obSH ? obST : fvSH ? fvST : mtST
zBearBot  = obSH ? obSB : fvSH ? fvSB : mtSB
zBearKind = obSH ? obKS : fvSH ? fvKS : mtKS

// ───────────────────────────── LIQUIDITY POOLS ─────────────────────────────
f_addPool(float lvl, int dir, int x1, bool major, bool htf, float wTop, float wBot) =>
    bool merged = false
    if array.size(pools) > 0
        for i = 0 to array.size(pools) - 1
            p = array.get(pools, i)
            if p.dir == dir and math.abs(p.lvl - lvl) <= syminfo.mintick * 2
                p.major := p.major or major
                p.htf := p.htf or htf
                line.set_width(p.ln, p.major or p.htf ? 2 : 1)
                line.set_style(p.ln, p.major or p.htf ? line.style_solid : line.style_dotted)
                merged := true
                break
    if not merged
        arr = dir == 1 ? recHi : recLo
        int t = 1
        if array.size(arr) > 0
            for v in arr
                if math.abs(v - lvl) <= eqTol * atr14
                    t += 1
        array.push(arr, lvl)
        if array.size(arr) > 60
            array.shift(arr)
        if major or htf or showMinor or t >= 2
            col = dir == 1 ? cBSL : cSSL
            w = t >= 3 ? 3 : t == 2 ? 2 : 1
            tr = t >= 3 ? 0 : t == 2 ? 30 : 55
            ln = line.new(x1, lvl, bar_index + liqExt, lvl, color = color.new(col, tr), width = math.max(w, major or htf ? 2 : 1), style = major or htf ? line.style_solid : line.style_dotted)
            txt = (dir == 1 ? "BSL" : "SSL") + (htf ? " (HTF)" : major ? " (MAJOR)" : "") + (t >= 2 ? " x" + str.tostring(t) : "")
            lb = major or htf or minorTxt ? label.new(bar_index + liqExt, lvl, txt, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(col, 10), size = size.tiny) : na
            bx = anchorWick and not na(wTop) ? box.new(x1, math.max(wTop, wBot), bar_index, math.min(wTop, wBot), border_color = color.new(col, 60), bgcolor = color.new(col, 85)) : na
            array.push(pools, Pool.new(ln, bx, lb, lvl, dir, t, major, htf))
            if array.size(pools) > 40
                old = array.shift(pools)
                line.delete(old.ln)
                box.delete(old.bx)
                label.delete(old.lb)
    true

if showLiq
    if not na(phMin)
        bt = math.max(open[minorLen], close[minorLen])
        wr = (high[minorLen] - bt) / math.max(high[minorLen] - low[minorLen], syminfo.mintick)
        f_addPool(phMin, 1, bar_index - minorLen, false, false, wr >= wickRatio ? high[minorLen] : na, bt)
    if not na(plMin)
        bb = math.min(open[minorLen], close[minorLen])
        wr = (bb - low[minorLen]) / math.max(high[minorLen] - low[minorLen], syminfo.mintick)
        f_addPool(plMin, -1, bar_index - minorLen, false, false, wr >= wickRatio ? low[minorLen] : na, bb)
    if not na(phMaj)
        f_addPool(phMaj, 1, bar_index - majorLen, true, false, na, na)
    if not na(plMaj)
        f_addPool(plMaj, -1, bar_index - majorLen, true, false, na, na)
    if useHtfLiq and htfOk and not na(htfPH) and htfPH != nz(htfPH[1])
        f_addPool(htfPH, 1, bar_index - 10, true, true, na, na)
    if useHtfLiq and htfOk and not na(htfPL) and htfPL != nz(htfPL[1])
        f_addPool(htfPL, -1, bar_index - 10, true, true, na, na)

bool sweepBull = false   // sell-side swept and reclaimed -> long idea
bool sweepBear = false   // buy-side swept and rejected   -> short idea
float sweepLvl = na
float nearBSL = na
float nearSSL = na
bool nearBSLHard = false
bool nearSSLHard = false
if array.size(pools) > 0
    for i = array.size(pools) - 1 to 0
        p = array.get(pools, i)
        bool gone = false
        if p.dir == 1 and high > p.lvl
            gone := true
            if close < p.lvl
                sweepBear := true
                sweepLvl := p.lvl
        else if p.dir == -1 and low < p.lvl
            gone := true
            if close > p.lvl
                sweepBull := true
                sweepLvl := p.lvl
        if gone
            if purgeLiq
                line.delete(p.ln)
                box.delete(p.bx)
                label.delete(p.lb)
            else
                line.set_x2(p.ln, bar_index)
                line.set_color(p.ln, color.new(color.gray, 70))
                label.delete(p.lb)
            array.remove(pools, i)
        else
            line.set_x2(p.ln, bar_index + liqExt)
            label.set_x(p.lb, bar_index + liqExt)
            if p.dir == 1 and p.lvl > close and (na(nearBSL) or p.lvl < nearBSL)
                nearBSL := p.lvl
                nearBSLHard := p.major or p.htf
            if p.dir == -1 and p.lvl < close and (na(nearSSL) or p.lvl > nearSSL)
                nearSSL := p.lvl
                nearSSLHard := p.major or p.htf

// ───────────────────────────── CONSOLIDATION BOXES ─────────────────────────────
var box sBox     = na
var float sHi    = na
var float sLo    = na
var int sStartT  = 0
var bool sLive   = false
var bool sUpDone = false
var bool sDnDone = false
var box dBox     = na
var float dHi2   = na
var float dLo2   = na
var bool dLive   = false
bool boxBreakUp = false
bool boxBreakDn = false

if boxOn and boxMode == "Session Anchor"
    if sessStart
        sHi := high
        sLo := low
        sStartT := time
        sLive := true
        sUpDone := false
        sDnDone := false
        sBox := box.new(bar_index, high, bar_index, low, border_color = color.new(cBox, 40), bgcolor = color.new(cBox, boxBgT), text = sessName + " ACCUMULATION", text_size = size.tiny, text_color = color.new(cBox, 30), text_valign = text.align_top, text_halign = text.align_left)
        array.push(boxHist, sBox)
        if array.size(boxHist) > boxMaxHist
            box.delete(array.shift(boxHist))
    else if sLive
        if time - sStartT < boxHours * 3600000
            sHi := math.max(sHi, high)
            sLo := math.min(sLo, low)
            box.set_top(sBox, sHi)
            box.set_bottom(sBox, sLo)
            box.set_right(sBox, bar_index)
        else
            sLive := false
    if not sLive and not na(sHi) and not sessStart
        if not sUpDone and close > sHi and close > open and body >= dispBody * atr14
            boxBreakUp := true
            sUpDone := true
        if not sDnDone and close < sLo and close < open and body >= dispBody * atr14
            boxBreakDn := true
            sDnDone := true

if boxOn and boxMode == "Dynamic Squeeze"
    if not dLive and squeeze
        dLive := true
        dHi2 := hiN
        dLo2 := loN
        dBox := box.new(bar_index - sqMinBars + 1, hiN, bar_index, loN, border_color = color.new(cBox, 40), bgcolor = color.new(cBox, boxBgT), text = "SQUEEZE", text_size = size.tiny, text_color = color.new(cBox, 30), text_valign = text.align_top, text_halign = text.align_left)
        array.push(boxHist, dBox)
        if array.size(boxHist) > boxMaxHist
            box.delete(array.shift(boxHist))
    else if dLive
        if close > dHi2 and close > open and body >= dispBody * atr14
            boxBreakUp := true
            dLive := false
            box.set_text(dBox, "BULL EXPANSION")
        else if close < dLo2 and close < open and body >= dispBody * atr14
            boxBreakDn := true
            dLive := false
            box.set_text(dBox, "BEAR EXPANSION")
        else if close > dHi2 + driftBuf * atr14 or close < dLo2 - driftBuf * atr14
            dLive := false
        else
            // wick fakeouts keep the box intact; only bodies stretch it
            dHi2 := math.max(dHi2, math.max(open, close))
            dLo2 := math.min(dLo2, math.min(open, close))
            box.set_top(dBox, dHi2)
            box.set_bottom(dBox, dLo2)
            box.set_right(dBox, bar_index)

// ───────────────────────────── VOLUME PROFILE ─────────────────────────────
var map<int, float> vpVol = map.new<int, float>()
var map<int, float> vpBuy = map.new<int, float>()
var float vpStep = na
var int pocB     = na
var float pocV   = 0.0
var int vpStart  = 0
var float sDelta = 0.0
vpReset = vpMode == "Session" ? sessStart : vpMode == "Daily" ? timeframe.change("D") : timeframe.change("W")
if vpOn and (vpReset or na(vpStep))
    map.clear(vpVol)
    map.clear(vpBuy)
    vpStep := math.max(syminfo.mintick, nz(atr14, rng) * 0.1)
    pocB := na
    pocV := 0.0
    vpStart := bar_index
    sDelta := 0.0
sDelta += buyVol - sellVol
if vpOn and vol > 0 and vpStep > 0
    lb0 = int(math.floor(low / vpStep))
    hb0 = int(math.floor(high / vpStep))
    n = hb0 - lb0 + 1
    chunks = math.min(n, 40)
    for c = 0 to chunks - 1
        bk = lb0 + int(math.floor(c * n / float(chunks)))
        nv = nz(map.get(vpVol, bk)) + vol / chunks
        map.put(vpVol, bk, nv)
        map.put(vpBuy, bk, nz(map.get(vpBuy, bk)) + buyVol / chunks)
        if nv > pocV
            pocV := nv
            pocB := bk
pocPx = na(pocB) or na(vpStep) ? na : (pocB + 0.5) * vpStep

// ───────────────────────────── TRADE OPINION ─────────────────────────────
f_sl(int dir, string stype, float zTop, float zBot) =>
    float s = na
    float atrSL = dir == 1 ? close - atrMult * atr14 : close + atrMult * atr14
    if slMode == "Structure"
        if stype == "retest" and not na(zBot) and not na(zTop)
            s := dir == 1 ? zBot - 0.25 * atr14 : zTop + 0.25 * atr14
        else if stype == "sweep"
            s := dir == 1 ? low - 0.25 * atr14 : high + 0.25 * atr14
        else if stype == "breakout"
            s := dir == 1 ? (not na(swLo) and swLo < close ? swLo - 0.25 * atr14 : atrSL) : (not na(swHi) and swHi > close ? swHi + 0.25 * atr14 : atrSL)
    if na(s)
        s := atrSL
    r = math.abs(close - s)
    if r < 0.5 * atr14
        s := dir == 1 ? close - 0.5 * atr14 : close + 0.5 * atr14
    if r > 4.0 * atr14
        s := atrSL
    s

// Returns [quality, score, reasons]
f_eval(int dir, string stype, float risk) =>
    reasons = array.new<string>()
    int score = 0
    bool hard = false
    bool soft = false
    if stype != ""
        // higher timeframe
        if htfBias == dir
            score += 1
        else if htfBias == -dir
            score -= 1
            if useHtf
                hard := true
                array.push(reasons, "fighting HTF trend")
        // execution structure (sweeps are reversals by design)
        if stype != "sweep"
            if structTrend == dir
                score += 1
            else
                score -= 1
                if stype == "retest"
                    soft := true
                    array.push(reasons, "against structure")
        // order flow
        bool deltaOk = dir == 1 ? buyPct >= 50 : buyPct <= 50
        score += deltaOk ? 1 : -1
        if reqDelta and not deltaOk
            soft := true
            array.push(reasons, "delta not confirming")
        // auction value
        if not na(pocPx)
            bool pocOk = dir == 1 ? close > pocPx : close < pocPx
            score += pocOk ? 1 : -1
            if reqPOC and not pocOk
                soft := true
                array.push(reasons, dir == 1 ? "below POC" : "above POC")
        // regime
        if isChoppy or isWeak
            score -= 1
            if stype == "breakout" and isChoppy
                hard := true
                array.push(reasons, "choppy regime")
        // resting liquidity in the way of TP1
        float bar1 = dir == 1 ? nearBSL - close : close - nearSSL
        bool barHard = dir == 1 ? nearBSLHard : nearSSLHard
        if not na(bar1) and bar1 < math.max(tp1M, 1.0) * risk
            if softHard
                score -= barHard ? 2 : 1
                if barHard
                    hard := true
                else
                    soft := true
                array.push(reasons, barHard ? "major liquidity before TP1" : "minor liquidity before TP1")
            else
                score -= 1
                if stype == "breakout" and blockIntoLiq
                    hard := true
                else
                    soft := true
                array.push(reasons, "liquidity before TP1")
        // ADR exhaustion
        if adrExh
            score -= 1
            if stype == "breakout"
                hard := true
            else
                soft := true
            array.push(reasons, "ADR " + str.tostring(adrPct, "#") + "% used")
        // over-extension from the 10 EMA
        float ext = math.abs(close - ema10) / math.max(atr14, syminfo.mintick)
        if ext > 1.5 and not (setupRules and stype == "breakout")
            score -= 1
            soft := true
            array.push(reasons, "extended from 10 EMA")
    string q = stype == "" ? "" : useWeighted ? (hard and softHard ? "AVOID" : score >= minTake ? "TAKE" : score >= minWaitSc ? "WAIT" : "AVOID") : hard ? "AVOID" : soft ? "WAIT" : "TAKE"
    string why = array.size(reasons) > 0 ? array.join(reasons, ", ") : "clean confluence"
    [q, score, why]

useRetest = engine == "Hybrid" or engine == "Retest Only"
useBreak  = engine == "Hybrid" or engine == "Breakout Only"
useSweep  = engine == "Hybrid" or engine == "Sweep Only"

swL = useSweep and sweepBull and lowerWick >= 0.35
rtL = useRetest and zBullHit and close > open
boL = useBreak and close > open and body >= dispBody * atr14 and (bullBreak or boxBreakUp)
swS = useSweep and sweepBear and upperWick >= 0.35
rtS = useRetest and zBearHit and close < open
boS = useBreak and close < open and body >= dispBody * atr14 and (bearBreak or boxBreakDn)

lType = swL ? "sweep" : rtL ? "retest" : boL ? "breakout" : ""
sType = swS ? "sweep" : rtS ? "retest" : boS ? "breakout" : ""
boxNm = boxMode == "Session Anchor" ? "Session Box Breakout" : "Squeeze Breakout"
lName = swL ? "Liquidity Sweep Reversal" : rtL ? zBullKind + " Retest" : boL ? (boxBreakUp and not bullBreak ? boxNm : bullChoch ? "CHoCH Breakout" : "Swing Structure Breakout") : ""
sName = swS ? "Liquidity Sweep Reversal" : rtS ? zBearKind + " Retest" : boS ? (boxBreakDn and not bearBreak ? boxNm : bearChoch ? "CHoCH Breakout" : "Swing Structure Breakout") : ""

slL = f_sl(1, lType, zBullTop, zBullBot)
slS = f_sl(-1, sType, zBearTop, zBearBot)
[qL, scL, whyL] = f_eval(1, lType, math.abs(close - slL))
[qS, scS, whyS] = f_eval(-1, sType, math.abs(close - slS))

gateL = barstate.isconfirmed and lType != "" and sType == "" and sessionOk and tDir != 1 and (lastSigDir != 1 or (allowCont and bar_index - lastSigBar >= minBetween))
gateS = barstate.isconfirmed and sType != "" and lType == "" and sessionOk and tDir != -1 and (lastSigDir != -1 or (allowCont and bar_index - lastSigBar >= minBetween))

// WAIT -> retest recovery
bool recL = false
bool recS = false
float recSL = na
if waitRecovery and waitDir != 0 and barstate.isconfirmed and bar_index > waitBar
    if bar_index - waitBar > maxWait or tDir == waitDir
        waitDir := 0
    else if waitDir == 1 and (low <= ema10 or low <= waitTop) and close > open and buyPct >= 50 and close > ema10 and sessionOk
        recL := true
        recSL := f_sl(1, "retest", waitTop, math.min(waitBot, low))
        waitDir := 0
    else if waitDir == -1 and (high >= ema10 or high >= waitBot) and close < open and buyPct <= 50 and close < ema10 and sessionOk
        recS := true
        recSL := f_sl(-1, "retest", math.max(waitTop, high), waitBot)
        waitDir := 0

takeL  = (gateL and qL == "TAKE") or recL
takeS  = (gateS and qS == "TAKE") or recS
waitL  = gateL and qL == "WAIT"
waitS  = gateS and qS == "WAIT"
avoidL = gateL and qL == "AVOID"
avoidS = gateS and qS == "AVOID"

if waitL or waitS
    waitDir  := waitL ? 1 : -1
    waitBar  := bar_index
    waitTop  := math.max(open, close)
    waitBot  := math.min(open, close)
    waitName := waitL ? lName : sName

// ───────────────────────────── TRADE MANAGEMENT ─────────────────────────────
float exitPx = na
string exitWhy = ""
if tDir != 0 and bar_index > tBar and barstate.isconfirmed
    if tDir == 1
        if low <= tSL
            exitPx := tSL
            exitWhy := tStage == 0 ? "Stop loss" : "Trailing stop"
        else
            if tStage < 1 and high >= tTP1
                tStage := 1
                nTp1 += 1
                tSL := math.max(tSL, tEntry)
            if tStage < 2 and high >= tTP2
                tStage := 2
                tSL := math.max(tSL, tTP1)
            if high >= tTP3
                exitPx := tTP3
                exitWhy := "TP3"
            else if tStage >= 1
                tSL := math.max(tSL, close - trailAtr * atr14)
    else
        if high >= tSL
            exitPx := tSL
            exitWhy := tStage == 0 ? "Stop loss" : "Trailing stop"
        else
            if tStage < 1 and low <= tTP1
                tStage := 1
                nTp1 += 1
                tSL := math.min(tSL, tEntry)
            if tStage < 2 and low <= tTP2
                tStage := 2
                tSL := math.min(tSL, tTP1)
            if low <= tTP3
                exitPx := tTP3
                exitWhy := "TP3"
            else if tStage >= 1
                tSL := math.min(tSL, close + trailAtr * atr14)
if na(exitPx) and tDir != 0 and ((tDir == 1 and takeS) or (tDir == -1 and takeL))
    exitPx := close
    exitWhy := "Opposite signal"
if not na(exitPx)
    r = (exitPx - tEntry) / tRisk * tDir
    nTrades += 1
    sumR += r
    if r > 0
        nWins += 1
        grossW += r
    else
        grossL -= r
    for l in tLines
        if keepHist
            line.set_x2(l, bar_index)
            line.set_color(l, color.new(color.gray, histT))
        else
            line.delete(l)
    for lb in tLabels
        label.delete(lb)
    array.clear(tLines)
    array.clear(tLabels)
    tDir := 0

f_lvl(float y, color c, int w, string txt) =>
    l = line.new(bar_index, y, bar_index + tgtExt, y, color = c, width = w)
    lb = showTgtLbl ? label.new(bar_index + tgtExt, y, txt + " " + str.tostring(y, format.mintick), style = label.style_label_left, color = color.new(c, 75), textcolor = color.white, size = size.tiny) : na
    [l, lb]

if takeL or takeS
    d = takeL ? 1 : -1
    s0 = takeL ? (recL ? recSL : slL) : (recS ? recSL : slS)
    tDir   := d
    tBar   := bar_index
    tEntry := close
    tSL    := s0
    tRisk  := math.max(math.abs(close - s0), syminfo.mintick)
    tTP1   := close + d * tp1M * tRisk
    tTP2   := close + d * tp2M * tRisk
    tTP3   := close + d * tp3M * tRisk
    tStage := 0
    tSetup := (takeL ? (recL ? waitName : lName) : (recS ? waitName : sName))
    lastSigDir := d
    lastSigBar := bar_index
    [l0, b0] = f_lvl(tSL, cSL, 2, "SL")
    [l1, b1] = f_lvl(tEntry, color.gray, 1, "Entry")
    [l2, b2] = f_lvl(tTP1, cTP, 1, "TP1")
    [l3, b3] = f_lvl(tTP2, cTP, 1, "TP2")
    [l4, b4] = f_lvl(tTP3, cTP, 2, "TP3")
    array.push(tLines, l0)
    array.push(tLines, l1)
    array.push(tLines, l2)
    array.push(tLines, l3)
    array.push(tLines, l4)
    array.push(tLabels, b0)
    array.push(tLabels, b1)
    array.push(tLabels, b2)
    array.push(tLabels, b3)
    array.push(tLabels, b4)
else if tDir != 0 and array.size(tLines) == 5
    for l in tLines
        line.set_x2(l, bar_index + tgtExt)
    line.set_y1(array.get(tLines, 0), tSL)
    line.set_y2(array.get(tLines, 0), tSL)
    for lb in tLabels
        label.set_x(lb, bar_index + tgtExt)
    label.set_y(array.get(tLabels, 0), tSL)
    label.set_text(array.get(tLabels, 0), (tStage == 0 ? "SL " : "Trail SL ") + str.tostring(tSL, format.mintick))

plot(tDir != 0 ? tSL : na, "Trailing SL", color = cTrail, style = plot.style_linebr, linewidth = 1)

// remember what the HUD should show
if takeL or waitL or avoidL
    lastName := recL ? waitName + " (retest)" : lName
    lastQ    := recL ? "RETEST TAKE" : qL
    lastWhy  := recL ? "pullback held with buy pressure" : whyL
if takeS or waitS or avoidS
    lastName := recS ? waitName + " (retest)" : sName
    lastQ    := recS ? "RETEST TAKE" : qS
    lastWhy  := recS ? "pullback rejected with sell pressure" : whyS

// ───────────────────────────── SIGNAL LABELS ─────────────────────────────
if showSig and sigStyle == "Evaluation Labels"
    if takeL
        label.new(bar_index, low, recL ? "BUY [RETEST TAKE]" : "BUY [TAKE]", yloc = yloc.belowbar, style = label.style_label_up, color = recL ? #00c896 : #00b8d4, textcolor = color.white, size = size.small, tooltip = lName + " | " + whyL)
    if takeS
        label.new(bar_index, high, recS ? "SELL [RETEST TAKE]" : "SELL [TAKE]", yloc = yloc.abovebar, style = label.style_label_down, color = recS ? #00c896 : #ff1744, textcolor = color.white, size = size.small, tooltip = sName + " | " + whyS)
    if showWaitAv and waitL
        label.new(bar_index, low, "BUY [WAIT]", yloc = yloc.belowbar, style = label.style_label_up, color = #ffa000, textcolor = #1b1b1b, size = size.tiny, tooltip = lName + " | " + whyL)
    if showWaitAv and waitS
        label.new(bar_index, high, "SELL [WAIT]", yloc = yloc.abovebar, style = label.style_label_down, color = #ffa000, textcolor = #1b1b1b, size = size.tiny, tooltip = sName + " | " + whyS)
    if showWaitAv and avoidL
        label.new(bar_index, low, "BUY [AVOID]", yloc = yloc.belowbar, style = label.style_label_up, color = #4a0d17, textcolor = #ff5c75, size = size.tiny, tooltip = lName + " | " + whyL)
    if showWaitAv and avoidS
        label.new(bar_index, high, "SELL [AVOID]", yloc = yloc.abovebar, style = label.style_label_down, color = #4a0d17, textcolor = #ff5c75, size = size.tiny, tooltip = sName + " | " + whyS)

plotshape(showSig and sigStyle == "Classic Arrows" and takeL, "Buy", shape.triangleup, location.belowbar, #00b8d4, size = size.small)
plotshape(showSig and sigStyle == "Classic Arrows" and takeS, "Sell", shape.triangledown, location.abovebar, #ff1744, size = size.small)

// ───────────────────────────── VOLUME PROFILE DRAWING ─────────────────────────────
float vah = na
float val = na
if barstate.islast and vpOn
    for bx in vpBoxes
        box.delete(bx)
    array.clear(vpBoxes)
    for ln in vpLines
        line.delete(ln)
    array.clear(vpLines)
    keys = map.keys(vpVol)
    if array.size(keys) > 0 and vpStep > 0
        minB = int(array.min(keys))
        maxB = int(array.max(keys))
        nB = maxB - minB + 1
        rows = math.min(vpRows, nB)
        rowSz = nB / float(rows)
        rv = array.new<float>(rows, 0.0)
        rb = array.new<float>(rows, 0.0)
        for k in keys
            r = math.min(rows - 1, int((k - minB) / rowSz))
            array.set(rv, r, array.get(rv, r) + map.get(vpVol, k))
            array.set(rb, r, array.get(rb, r) + nz(map.get(vpBuy, k)))
        tot = array.sum(rv)
        mx = array.max(rv)
        pr = array.indexof(rv, mx)
        int lo = pr
        int hi = pr
        float acc = mx
        while acc < tot * vaPct / 100 and (lo > 0 or hi < rows - 1)
            up = hi < rows - 1 ? array.get(rv, hi + 1) : -1.0
            dn = lo > 0 ? array.get(rv, lo - 1) : -1.0
            if up >= dn
                hi += 1
                acc += up
            else
                lo -= 1
                acc += dn
        vah := (minB + (hi + 1) * rowSz) * vpStep
        val := (minB + lo * rowSz) * vpStep
        x0 = bar_index + 3
        if showVP and mx > 0
            for r = 0 to rows - 1
                v = array.get(rv, r)
                w = int(math.round(vpWidth * v / mx))
                if w > 0
                    yb = (minB + r * rowSz) * vpStep
                    yt = (minB + (r + 1) * rowSz) * vpStep
                    wb = int(math.round(w * array.get(rb, r) / math.max(v, 1e-10)))
                    inVA = r >= lo and r <= hi
                    if wb > 0
                        array.push(vpBoxes, box.new(x0, yt, x0 + wb, yb, border_color = color.new(cBuyV, 100), bgcolor = color.new(cBuyV, inVA ? 45 : 78)))
                    if w - wb > 0
                        array.push(vpBoxes, box.new(x0 + wb, yt, x0 + w, yb, border_color = color.new(cSellV, 100), bgcolor = color.new(cSellV, inVA ? 45 : 78)))
        if showPOC
            pocY = (minB + (pr + 0.5) * rowSz) * vpStep
            array.push(vpLines, line.new(vpStart, pocY, x0 + vpWidth, pocY, color = cPOC, width = 2))
            array.push(vpLines, line.new(vpStart, vah, x0 + vpWidth, vah, color = cVA, style = line.style_dashed))
            array.push(vpLines, line.new(vpStart, val, x0 + vpWidth, val, color = cVA, style = line.style_dashed))

// ───────────────────────────── HUD ─────────────────────────────
hudP  = hudPos == "Top Right" ? position.top_right : hudPos == "Top Left" ? position.top_left : hudPos == "Bottom Right" ? position.bottom_right : position.bottom_left
hudSz = hudSize == "Tiny" ? size.tiny : hudSize == "Small" ? size.small : size.normal
var table hud = table.new(hudP, 2, 13, bgcolor = color.new(#0b0f14, hudBgT), border_color = color.new(color.gray, 85), border_width = 1, frame_color = color.new(color.gray, 70), frame_width = 1)

f_fmt(float x) => str.tostring(x, format.mintick)

f_row(int r, string k, string v, color vc) =>
    table.cell(hud, 0, r, k, text_color = color.new(color.white, 35), text_size = hudSz, text_halign = text.align_left)
    table.cell(hud, 1, r, v, text_color = vc, text_size = hudSz, text_halign = text.align_left)

if barstate.islast and hudOn
    stateTxt = tDir == 1 ? "LONG ACTIVE" : tDir == -1 ? "SHORT ACTIVE" : "FLAT / SCANNING"
    stateCol = tDir == 1 ? cBull : tDir == -1 ? cBear : color.silver
    f_row(0, "TWO-SPEED FLOW", stateTxt, stateCol)
    biasTxt = "Structure " + (structTrend == 1 ? "BULL" : structTrend == -1 ? "BEAR" : "-") + " | HTF " + (htfBias == 1 ? "BULL" : htfBias == -1 ? "BEAR" : "-") + " | EMA " + (ltfBias == 1 ? "up" : "down")
    f_row(1, "Bias", biasTxt, structTrend == htfBias and structTrend != 0 ? (structTrend == 1 ? cBull : cBear) : color.orange)
    f_row(2, "Regime", regimeTxt + " | Chop " + str.tostring(chopVal, "#") + " | ADX " + str.tostring(adxV, "#"), isChoppy ? color.orange : color.silver)
    auct = na(pocPx) ? "-" : not na(vah) and close > vah ? "Above Value" : not na(val) and close < val ? "Below Value" : close > pocPx ? "In Value, above POC" : "In Value, below POC"
    f_row(3, "Auction", auct + (na(pocPx) ? "" : " | POC " + f_fmt(pocPx)), color.silver)
    f_row(4, "Pressure", str.tostring(buyPct, "#") + "% buy / " + str.tostring(100 - buyPct, "#") + "% sell | session delta " + str.tostring(sDelta, format.volume), buyPct >= 50 ? cBull : cBear)
    f_row(5, "ADR / Asia", str.tostring(adrPct, "#") + "% of ADR | AH " + (aSweptH ? "swept" : "intact") + " | AL " + (aSweptL ? "swept" : "intact"), adrExh ? color.orange : color.silver)
    f_row(6, "Setup", tDir != 0 ? tSetup : lastName, color.white)
    opCol = str.contains(lastQ, "TAKE") ? cBull : lastQ == "WAIT" ? color.orange : lastQ == "AVOID" ? cBear : color.silver
    f_row(7, "Opinion", lastQ + " - " + lastWhy, opCol)
    ext = math.abs(close - ema10) / math.max(atr14, syminfo.mintick)
    pbRisk = ext < 0.75 ? "LOW" : ext < 1.5 ? "NORMAL" : "HIGH"
    if tDir != 0
        f_row(8, "Fill / SL", f_fmt(tEntry) + " / " + f_fmt(tSL) + " | risk " + f_fmt(tRisk) + " | pullback " + pbRisk, color.white)
        f_row(9, "Targets", "TP1 " + f_fmt(tTP1) + " | TP2 " + f_fmt(tTP2) + " | TP3 " + f_fmt(tTP3), cTP)
        look = tStage == 0 ? "Targeting TP1" : tStage == 1 ? "SL at breakeven, seeking TP2" : "Runner: trailing toward TP3"
        f_row(10, "Manage", look + " | SL " + f_fmt(tSL), cTrail)
    else
        f_row(8, "Fill / SL", "-", color.gray)
        f_row(9, "Targets", "-", color.gray)
        look = lastQ == "WAIT" ? "Wait for pullback to 10 EMA / signal candle, then confirmation" : lastQ == "AVOID" ? "Stand aside: " + lastWhy : "Scanning for a clean setup | pullback risk " + pbRisk
        f_row(10, "Look for", look, color.silver)
    wr = nTrades > 0 ? nWins * 100.0 / nTrades : 0.0
    pf = grossL > 0 ? grossW / grossL : 0.0
    f_row(11, "Performance", str.tostring(nTrades) + " trades | win " + str.tostring(wr, "#") + "% | avg " + str.tostring(nTrades > 0 ? sumR / nTrades : 0.0, "#.##") + "R | total " + str.tostring(sumR, "#.#") + "R | PF " + str.tostring(pf, "#.##"), sumR >= 0 ? cBull : cBear)
    f_row(12, "TP1 touch rate", str.tostring(nTrades > 0 ? nTp1 * 100.0 / nTrades : 0.0, "#") + "% (not the same as profit)", color.gray)

// ───────────────────────────── ALERTS ─────────────────────────────
f_num(float x) => na(x) ? "null" : str.tostring(x)
f_json(int d, string q, string setup, float sl) =>
    rk = math.abs(close - sl)
    '{"source":"tsflow","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","side":"' + (d == 1 ? "long" : "short") + '","quality":"' + q + '","setup":"' + setup + '","price":' + f_num(close) + ',"sl":' + f_num(sl) + ',"tp1":' + f_num(close + d * tp1M * rk) + ',"tp2":' + f_num(close + d * tp2M * rk) + ',"tp3":' + f_num(close + d * tp3M * rk) + ',"htf":' + str.tostring(htfBias) + ',"structure":' + str.tostring(structTrend) + '}'
f_txt(int d, string q, string setup, float sl) =>
    (d == 1 ? "BUY " : "SELL ") + "[" + q + "] " + syminfo.ticker + " " + timeframe.period + " | " + setup + " | price " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick)

if barstate.isconfirmed
    if alTake and takeL
        q0 = recL ? "RETEST TAKE" : "TAKE"
        alert(alJson ? f_json(1, q0, tSetup, tSL) : f_txt(1, q0, tSetup, tSL), alert.freq_once_per_bar_close)
    if alTake and takeS
        q1 = recS ? "RETEST TAKE" : "TAKE"
        alert(alJson ? f_json(-1, q1, tSetup, tSL) : f_txt(-1, q1, tSetup, tSL), alert.freq_once_per_bar_close)
    if alWait and (waitL or waitS)
        alert(alJson ? f_json(waitL ? 1 : -1, "WAIT", waitL ? lName : sName, waitL ? slL : slS) : f_txt(waitL ? 1 : -1, "WAIT", waitL ? lName : sName, waitL ? slL : slS), alert.freq_once_per_bar_close)
    if alAvoid and (avoidL or avoidS)
        alert(alJson ? f_json(avoidL ? 1 : -1, "AVOID", avoidL ? lName : sName, avoidL ? slL : slS) : f_txt(avoidL ? 1 : -1, "AVOID", avoidL ? lName : sName, avoidL ? slL : slS), alert.freq_once_per_bar_close)
    if alChoch and (bullChoch or bearChoch)
        alert((bullChoch ? "Bullish" : "Bearish") + " CHoCH on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

alertcondition(takeL, "TS Flow BUY TAKE", "BUY [TAKE] on {{ticker}} {{interval}} at {{close}}")
alertcondition(takeS, "TS Flow SELL TAKE", "SELL [TAKE] on {{ticker}} {{interval}} at {{close}}")
